# ── MySQL Database Configuration ──
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=rba_tool_database

# ── Auth / JWT Secret Key (32+ chars recommended) ──
JWT_SECRET_KEY=change_this_to_a_secure_random_secret_key_32chars

# ── CIT (Corporate Income Tax) Paths ──
CIT_MODEL_PATH=cit/models/xgboost_fraud_model.pkl
CIT_SCALER_PATH=cit/models/scaler.pkl
CIT_FEATURES_PATH=cit/models/feature_columns.pkl
CIT_TIN_REG_PATH=cit/data/25.05.21.05 TIN Registrations.csv

# ── GST (Goods and Services Tax) Paths ──
GST_MODEL_PATH=gst/models/xgboost_selected_model.pkl
GST_FEATURES_PATH=gst/models/feature_info_selected.pkl
GST_TIN_REG_PATH=gst/data/25.05.21.05 TIN Registrations.xlsx
GST_DATA_PATH=gst/data/gst_merged_2015_2025.parquet

# ── SWT (Salary and Wages Tax) Paths ──
SWT_MODEL_PATH=swt/models/xgboost_model.pkl
SWT_JUSTIFICATION_PKL=swt/models/fraud_justification.pkl
SWT_TIN_REG_PATH=swt/Data/25.05.21.05 TIN Registrations.xlsx
SWT_DATA_PATH=swt/Data/swt_merged_data_2015_2024.parquet

# ── Pipeline & Storage ──
UPLOAD_LOG_PATH=upload_history.log
TEMP_OUTPUT_DIR=temp_outputs
FINAL_OUTPUT_DIR=final_output
